# --- Tauri ---
# Capability JSON schemas are regenerated on every build.
apps/desktop/src-tauri/gen/schemas/
# Mobile projects are generated by `tauri ios|android init`. When added,
# commit apps/desktop/src-tauri/gen/apple and gen/android but not their build outputs:
apps/desktop/src-tauri/gen/apple/build/
apps/desktop/src-tauri/gen/apple/DerivedData/
apps/desktop/src-tauri/gen/apple/Externals/
apps/desktop/src-tauri/gen/android/.gradle/
apps/desktop/src-tauri/gen/android/build/
apps/desktop/src-tauri/gen/android/app/build/
apps/desktop/src-tauri/gen/android/local.properties
apps/desktop/src-tauri/gen/android/keystore.properties

