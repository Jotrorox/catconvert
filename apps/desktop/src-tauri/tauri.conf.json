{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CatConvert",
  "version": "0.1.4",
  "identifier": "dev.jotrorox.catconvert",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CatConvert",
        "width": 1180,
        "height": 820,
        "minWidth": 520,
        "minHeight": 400,
        "dragDropEnabled": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 19, "y": 28 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Offline photo, video and audio converter",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/shell.wxs"],
        "componentRefs": ["CatConvertOpenWith", "CatConvertSendTo"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExN0NENzU2QkYwREEyMDUKUldRRm9nMi9WdGQ4b1lRWXpXNGJTeUdnOGRWdXJmemtuc0RjZjNsVHh4QVp2MnZ5eGVRUEpiUU4K",
      "endpoints": ["https://github.com/Jotrorox/catconvert/releases/latest/download/latest.json"]
    }
  }
}
